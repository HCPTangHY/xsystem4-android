diff --git a/src/file.c b/src/file.c
index 72cd009..0d59e70 100644
--- a/src/file.c
+++ b/src/file.c
@@ -214,11 +214,111 @@ char *path_basename(const char *path)
 
 #else
 
+#include <strings.h>
+
 #define make_dir(path, mode) mkdir(path, mode)
 
+/*
+ * CN ports mix codepages inside one directory tree: the data was extracted on
+ * Windows with the GBK codepage (so a folder carries the GBK reading of the
+ * original SJIS bytes, e.g. "婄俠俧" for "顔ＣＧ"), while other entries kept
+ * their Japanese kana ("AliceSoft_02_ガード１.png"). Paths coming from the
+ * game are converted with the GBK reading, so a kana name does not match.
+ *
+ * When an exact lookup fails we retry with the other interpretation of the
+ * same bytes and search the parent directory for a matching entry.
+ */
+static char *alt_name_decoding(const char *utf8)
+{
+	char *gbk = utf2gbk(utf8, 0);
+	char *alt = sjis2utf_sjis(gbk, 0);
+	free(gbk);
+	return alt;
+}
+
+static char *find_dirent_match(const char *dir, const char *name)
+{
+	char *alt = alt_name_decoding(name);
+	DIR *d = opendir(dir && *dir ? dir : ".");
+	if (!d) {
+		free(alt);
+		return NULL;
+	}
+	struct dirent *e;
+	char *found = NULL;
+	while ((e = readdir(d))) {
+		if (!strcmp(e->d_name, ".") || !strcmp(e->d_name, ".."))
+			continue;
+		if (!strcasecmp(e->d_name, name) ||
+		    (alt && !strcasecmp(e->d_name, alt))) {
+			found = xstrdup(e->d_name);
+			break;
+		}
+	}
+	closedir(d);
+	free(alt);
+	return found;
+}
+
+// Returns an existing path equivalent to `path`, or NULL if none exists.
+static char *resolve_existing_path(const char *path)
+{
+	ustat st;
+	if (stat(path, &st) == 0)
+		return xstrdup(path);
+
+	char *alt = alt_name_decoding(path);
+	if (alt && stat(alt, &st) == 0)
+		return alt;
+	free(alt);
+
+	char *work = xstrdup(path);
+	char *out = xmalloc(PATH_MAX);
+	out[0] = '\0';
+	if (path[0] == '/')
+		strcpy(out, "/");
+
+	char *saveptr = NULL;
+	for (char *comp = strtok_r(work, "/", &saveptr); comp;
+	     comp = strtok_r(NULL, "/", &saveptr)) {
+		char cand[PATH_MAX];
+		size_t len = strlen(out);
+		snprintf(cand, sizeof(cand), "%s%s%s", out,
+		         (len && out[len - 1] != '/') ? "/" : "", comp);
+		if (stat(cand, &st) != 0) {
+			char *match = find_dirent_match(*out ? out : ".", comp);
+			if (!match) {
+				free(work);
+				free(out);
+				return NULL;
+			}
+			len = strlen(out);
+			snprintf(cand, sizeof(cand), "%s%s%s", out,
+			         (len && out[len - 1] != '/') ? "/" : "", match);
+			free(match);
+			if (stat(cand, &st) != 0) {
+				free(work);
+				free(out);
+				return NULL;
+			}
+		}
+		snprintf(out, PATH_MAX, "%s", cand);
+	}
+	free(work);
+	return out;
+}
+
 UDIR *opendir_utf8(const char *path)
 {
-	return opendir(path);
+	UDIR *d = opendir(path);
+	if (d || errno != ENOENT)
+		return d;
+	char *resolved = resolve_existing_path(path);
+	if (!resolved)
+		return NULL;
+	d = opendir(resolved);
+	free(resolved);
+	return d;
 }
 
 int closedir_utf8(UDIR *dir)
@@ -236,7 +336,15 @@ char *readdir_utf8(UDIR *dir)
 
 int stat_utf8(const char *path, ustat *st)
 {
-	return stat(path, st);
+	int r = stat(path, st);
+	if (r == 0 || errno != ENOENT)
+		return r;
+	char *resolved = resolve_existing_path(path);
+	if (!resolved)
+		return r;
+	r = stat(resolved, st);
+	free(resolved);
+	return r;
 }
 
 char *realpath_utf8(const char *upath)
@@ -256,7 +364,16 @@ int rmdir_utf8(const char *path)
 
 FILE *file_open_utf8(const char *path, const char *mode)
 {
-	return fopen(path, mode);
+	FILE *fp = fopen(path, mode);
+	if (fp || errno != ENOENT || mode[0] != 'r')
+		return fp;
+	// Reading a file whose name was decoded with the other codepage.
+	char *resolved = resolve_existing_path(path);
+	if (!resolved)
+		return NULL;
+	fp = fopen(resolved, mode);
+	free(resolved);
+	return fp;
 }
 
 char *path_dirname(const char *path)
